{
  "name": "bap",
  "version": "0.0.0",
  "private": true,
  "description": "Business Analytics Platform monorepo",
  "scripts": {
    "build": "IBM_TELEMETRY_DISABLED=true NEXT_TELEMETRY_DISABLED=1 turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "compose:config": "docker compose -f compose.yaml -f compose.development.yaml config --quiet",
    "compose:config:production": "docker compose -f compose.yaml -f compose.production.yaml config --quiet",
    "dev": "IBM_TELEMETRY_DISABLED=true NEXT_TELEMETRY_DISABLED=1 turbo run dev --concurrency=4",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "packageManager": "pnpm@11.24.0"
}
